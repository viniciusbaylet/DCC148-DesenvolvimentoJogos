[sub_resource type="GDScript" id="GDScript_jyhfs"]
script/source = "extends StaticBody2D

@onready var timer: Timer = $Timer
@onready var label_tempo: Label = $Label # Substitua pelo caminho exato do seu Label na cena
@onready var game_over_screen: CanvasLayer = $GameOverScreen # Substitua pelo caminho da sua tela de Game Over

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	get_tree().paused = false
	game_over_screen.visible = false
	
	timer.timeout.connect(_on_timer_timeout)


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	var tempo_restante = ceil(timer.time_left)
	label_tempo.text = \"Tempo: \" + str(tempo_restante)

# Função chamada quando o tempo acaba
func _on_timer_timeout() -> void:
	acionar_game_over(\"O tempo acabou!\")

# Função central para chamar o Game Over de qualquer lugar da fase
fn acionar_game_over(motivo: String) -> void:
	var reason_label = game_over_screen.get_node(\"ColorRect/VBoxContainer/Label2\")
	if reason_label:
		reason_label.text = motivo
		
	game_over_screen.visible = true
	get_tree().paused = true # Pausa o jogo inteiro
"

